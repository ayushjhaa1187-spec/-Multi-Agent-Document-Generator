# ===== AI & LLM Configuration =====
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Anthropic API Key (for fallback)
ANTHROPIC_API_KEY=

# ===== Database Configuration =====
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/brd_generator
# Vercel Postgres: Copy from Vercel dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/brd_generator

# ===== Redis Configuration (Optional) =====
# For production caching and performance optimization
# Format: redis://user:password@host:port
REDIS_URL=

# ===== Environment =====
# development | production | staging
NODE_ENV=development

# ===== Vercel Configuration =====
# Your application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Analytics Configuration (Optional) =====
# Enable/disable analytics tracking
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ===== Security Configuration =====
# Session secret for secure cookies
SESSION_SECRET=your-secure-random-string-here

# Admin secret for protecting internal API endpoints
ADMIN_SECRET=your-secure-admin-secret-here

# ===== Rate Limiting (Optional) =====
# Max requests per minute
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ===== Logging =====
# Log level: error, warn, info, debug
LOG_LEVEL=info

