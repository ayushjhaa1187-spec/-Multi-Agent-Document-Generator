# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Database Configuration
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/brd_generator
# Vercel Postgres: Copy from Vercel dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/brd_generator

# Environment
# development | production
NODE_ENV=development

# Optional: Anthropic API Key (for fallback)
ANTHROPIC_API_KEY=

# Optional: Vercel specific
NEXT_PUBLIC_APP_URL=http://localhost:3000
