generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id String @id @default(cuid())
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  documents BRD[] @relation("ProjectBRDs")
  
  @@index([createdAt])
}

model BRD {
  id String @id @default(cuid())
  projectId String
  project Project @relation("ProjectBRDs", fields: [projectId], references: [id], onDelete: Cascade)
  
  version Int @default(1)
  content Json?
  rawInput String
  generatedBy String @default("gpt-4o")
  status String @default("draft")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}
